# BlueprintParser Deployment Configuration
# Copy this file to .deploy.env and fill in your values:
#   cp .deploy.env.example .deploy.env
#
# .deploy.env is gitignored and will not be committed.

AWS_ACCOUNT=YOUR_12_DIGIT_ACCOUNT_ID
AWS_REGION=us-east-1

# ECS
ECS_CLUSTER=beaver-cluster
ECS_SERVICE=beaver-app
# The P2 cutover derives and cross-checks the canonical Step Functions ARN from
# the digest-pinned app task definition; it is intentionally not configurable.
# Image digests are also intentionally absent: supply the baseline and intended
# candidate explicitly to `deploy.sh preflight-outage BASELINE CANDIDATE`.

# ECR
ECR_REPO=beaver-app
ECR_YOLO_REPO=beaver-yolo-pipeline

# Monitoring / Health Checks
ALB_NAME=beaver-alb
RDS_ID=beaver-db
LOG_GROUP=/ecs/beaver-app
SNS_TOPIC=beaver-alerts

# Owner-reviewed public identities. CLOUDFRONT_DISTRIBUTION_ID must name the
# distribution serving assets.${DOMAIN}; deployment admission checks both exact
# task-definition values. Keep ROOT_ADMIN_EMAIL present even when intentionally
# empty so promotion authority is an explicit operator choice.
DOMAIN=yourdomain.com
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
ROOT_ADMIN_EMAIL=

# Secrets Manager prefix
SECRETS_PREFIX=beaver

# CV Lambda Pipeline (symbol search + shape parse fan-out)
ECR_CV_REPO=beaver-cv-lambda
LAMBDA_FUNCTION_NAME=beaver-cv-pipeline
LAMBDA_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/beaver-cv-pipeline-role
ECS_TASK_ROLE=beaver-ecs-task-role
