DATABASE_URL=postgresql://beaver:beaver@localhost:5433/beaverdb
NEXTAUTH_SECRET=generate-a-random-secret
NEXTAUTH_URL=http://localhost:3000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-s3-bucket-name
# Optional legacy-cache invalidation only; set both CloudFront values or neither.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_DISTRIBUTION_ID=
STEP_FUNCTION_ARN=
PROCESSING_WEBHOOK_SECRET=generate-a-random-secret
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# LLM Config encryption key (for storing API keys in DB)
# Falls back to NEXTAUTH_SECRET if not set
LLM_KEY_SECRET=generate-a-random-32-char-secret

# Override LLM provider via env (alternative to admin UI config)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=http://localhost:11434/v1

# Label Studio (data labeling integration — optional)
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
# Stable logical provider identity. Increment it whenever the Label Studio database is
# reinitialized/replaced, even if its underlying volume survives; BP retains old cleanup witnesses.
LABEL_STUDIO_INSTANCE_ID=local-label-studio-data-v1
# Bootstrap credentials are consumed only by the Label Studio container. The BP application never
# returns them over HTTP; rotate both during the 0037 cutover before browser sessions resume.
LABEL_STUDIO_ADMIN_EMAIL=admin@localhost.local
LABEL_STUDIO_ADMIN_PASSWORD=changeme123

# Optional: YOLO/SageMaker (GPU object detection)
# YOLO_ECR_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/your-yolo-image:latest
# SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT:role/your-sagemaker-role

# Optional: Lambda CV Pipeline (parallel symbol search + shape parse)
# LAMBDA_CV_ENABLED=false
# LAMBDA_CV_FUNCTION_NAME=your-cv-pipeline-function-name

# Optional: SES Email (password recovery)
# SES_FROM_EMAIL=noreply@yourdomain.com

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Root admin bootstrap (first user with this email gets root admin on login)
# ROOT_ADMIN_EMAIL=admin@yourdomain.com

# --- local pipeline ---
# Runs the processing pipeline in-process instead of handing off to Step Functions.
# Default false; this is the switch most local contributors want.
# DEV_PROCESSING_ENABLED=true

# --- tests ---
# scripts/test-db.sh starts a user-owned PostgreSQL cluster on :5433 with these credentials.
# BP_REQUIRE_TEST_DB=1 makes the route and migration-boundary tests FAIL instead of silently
# skipping when no test database is reachable — without it a local run can report a false green.
# BP_REQUIRE_TEST_DB=1
# BP_TEST_DATABASE_URL=postgres://bp_test:bp_test@localhost:5433/bp_test
# BP_TEST_S3_ENDPOINT=

# --- feature flags ---
# Build-time default for the bucket-fill engine. Defaults to `raster`; leave it unset unless you
# are working on that arc. Read once at build time — Next.js inlines NEXT_PUBLIC_* values.
# NEXT_PUBLIC_BUCKET_FILL_MODE=raster
# Verbose table-parse diagnostics in the viewer. Set to 1 to enable.
# NEXT_PUBLIC_TABLE_PARSE_DEBUG=1

# --- ops / misc (code defaults noted) ---
# LOG_LEVEL=info
# ALLOW_MODEL_UPLOAD=false        # weights-upload kill switch; uploads are disabled by default
# GEOIP_DB_PATH=                  # default: ./geo/GeoLite2-Country.mmdb
# next-auth v5 reads AUTH_SECRET; NEXTAUTH_SECRET above is kept for compatibility and is used as
# the fallback, so setting only NEXTAUTH_SECRET works. At least one of the pair is required in prod.
# AUTH_SECRET=

# Deployment-only variables (AWS_ACCOUNT, CLOUDWATCH_LOG_GROUP, PROJECT_ASSET_EVENT_QUEUE_URL,
# LAMBDA_CV_BATCH_SIZE, …) live in .deploy.env.example. The server validates its env contract at
# boot in src/lib/env.ts.
