{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // [P2-entry jul9] .next/dev/types/validator.ts is EXCLUDED: Next 16.2.4's dev typegen drops
  // depth-5 routes (api/demo/projects/[id]/pages + api/projects/[id]/thumbnail/[page]) from
  // routes.d.ts while validator.ts still checks them → generated-vs-generated TS2344 that no
  // source change can fix, corrupting `tsc --noEmit` after every dev run. Deterministic
  // (`next typegen` reproduces it). BUILD typegen (.next/types) is complete — `next build`'s
  // own validator check still runs at deploy. Re-test on any Next upgrade; drop the exclude
  // once upstream includes depth-5 routes in dev routes.d.ts.
  "exclude": ["node_modules", ".next/dev/types/validator.ts"]
}
