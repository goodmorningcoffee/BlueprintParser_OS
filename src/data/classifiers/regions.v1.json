{
 "id": "regions.v1",
 "name": "Legends / notes / keynotes",
 "version": 1,
 "enabled": true,
 "unit": "region",
 "target": "text-region",
 "_how": "Port of region v2's text classes (region-classes.v2.json `text`): the same keyword weights, now as one words signal per class over the box (saturation 3, weight 5 \u2192 a 5-point phrase alone clears the bar) plus the title line, the CSI division share and the title-block priors. Detect reuses region v2's structure score. Falls back to 'text (unclassified)' with the derived title.",
 "candidates": [
  {
   "type": "regions-v2",
   "kinds": [
    "legend",
    "notes",
    "keynotes"
   ]
  }
 ],
 "scope": {
  "excludeTitleBlock": true,
  "minWords": 3
 },
