# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every .env variant (incl. the .env.local.bak.<epoch> backups install_setup.sh writes)
.env*
!.env.example

# deployment config
.deploy.env*
!.deploy.env.example

# secrets / terraform state, at any depth (real values live outside the repo)
**/*.tfvars
!**/*.tfvars.example
**/*.tfstate*
**/backend.hcl
infrastructure/terraform/.terraform/
infrastructure/terraform/.terraform.lock.hcl
*.bak
*.bak.*

# Model WEIGHTS (large binary files). ANCHORED to the repo root: the weights live in /models
# (yolo_*.pt, tatr/model.safetensors). An un-anchored `models/` would also match the SOURCE
# directory src/app/api/admin/models/. scripts/prepush-check.sh refuses a push without this line.
/models/

# local planning notes and scratch files (anchored: a same-named file under src/ stays tracked)
/gitignore/
/perf/private-gateway-baseline.json
/plans/
/REFACTORED_MARCH29.md
/bucket-fill.md
/csv-editor-panel.md
/symbol-search-fix.md

# drawings and logs never belong in git (test PDFs live under the ignored test/fixtures/)
*.pdf
*.log
.pytest_cache/

# editors
.vscode/
.idea/
*.swp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test/fixtures/
e2e/.state/
perf/latest.json
test-results/
playwright-report/
__pycache__/

# terraform saved-plans embed tfstate/secrets - never commit
*.plan
*.tfplan

# CSI v2 MasterFormat lookup table (owner ruling D1, 2026-10-20): ~11,500 keyword phrases from the
# MasterFormat PDF are NOT redistributed on the public GitHub. Built locally from the PDF by
# eval/csi/build-kb-v2.ts; it still SHIPS because the image is built from the working tree
# (.dockerignore does not exclude src/data). ANCHORED on purpose.
/src/data/csi-kb.json
# Parser test fixture with verbatim MasterFormat PDF page text (owner ruling 2026-10-20, same as D1):
# not redistributed on the public GitHub; regenerate with eval/csi/mf-fixture-extract.ts. ANCHORED.
/src/lib/__tests__/fixtures/csi-v2/mf-pages-excerpt.json
