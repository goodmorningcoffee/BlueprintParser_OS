    "db:studio": "node scripts/run-local-drizzle-command.mjs studio",
    "test": "vitest run",
    "test:scripts": "node --test scripts/__tests__/*.node-test.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
